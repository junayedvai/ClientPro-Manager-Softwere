<UserControl x:Class="ClientProManager.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,12">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Users &amp; Roles" FontSize="28" FontWeight="Bold" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Refresh" Command="{Binding LoadCommand}" />
                    <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Disable" Command="{Binding DisableCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat=g}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="User Details" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Full Name" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableUser.FullName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Username" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableUser.Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Email" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableUser.Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Phone" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableUser.Phone, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Role" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditableUser.Role}" />
                <CheckBox Content="Active" IsChecked="{Binding EditableUser.IsActive}" Margin="0,4,0,10" />
                <TextBlock Text="New/Reset Password" FontWeight="SemiBold" />
                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Save User" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
                <Button Content="Reset Password" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Activity Log" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding ActivityLogs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat=g}" Width="140" />
                        <DataGridTextColumn Header="User" Binding="{Binding User.Username}" Width="120" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="160" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="120" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
