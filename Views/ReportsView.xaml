<UserControl x:Class="ClientProManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Reports" FontSize="28" FontWeight="Bold" />
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="220">
                        <TextBlock Text="Report Type" />
                        <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="From" />
                        <DatePicker SelectedDate="{Binding FromDate}" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="To" />
                        <DatePicker SelectedDate="{Binding ToDate}" />
                    </StackPanel>
                    <Button Content="Run" Command="{Binding RunReportCommand}" />
                    <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="Details" Binding="{Binding SecondaryLabel}" Width="*" />
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80" />
                    <DataGridTextColumn Header="Income" Binding="{Binding Income, StringFormat=N2}" Width="120" />
                    <DataGridTextColumn Header="Expense" Binding="{Binding Expense, StringFormat=N2}" Width="120" />
                    <DataGridTextColumn Header="Due" Binding="{Binding Due, StringFormat=N2}" Width="120" />
                    <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=N2}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
