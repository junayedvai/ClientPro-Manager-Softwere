<Window x:Class="ClientProManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClientPro Manager"
        Width="1360"
        Height="840"
        Icon="/Resources/ClientProManager.ico"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,24">
                    <TextBlock Text="ClientPro"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Manager"
                               FontSize="18"
                               Foreground="{StaticResource SidebarMutedTextBrush}" />
                    <TextBlock Text="{Binding CurrentUserDisplay}"
                               Margin="0,16,0,0"
                               Foreground="{StaticResource SidebarMutedTextBrush}" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom"
                        Content="Logout"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="18" />

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         DisplayMemberPath="Title"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="10,0,10,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SidebarNavItem}" />
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding CurrentViewModel}" />
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
