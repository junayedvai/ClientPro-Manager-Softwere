<UserControl x:Class="ClientProManager.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Expense Management" FontSize="28" FontWeight="Bold" />
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="150">
                        <TextBlock Text="From" />
                        <DatePicker SelectedDate="{Binding FromDate}" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="To" />
                        <DatePicker SelectedDate="{Binding ToDate}" />
                    </StackPanel>
                    <StackPanel Width="180">
                        <TextBlock Text="Category" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                    </StackPanel>
                    <Button Content="Filter" Command="{Binding LoadCommand}" />
                    <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat=d}" Width="100" />
                    <DataGridTextColumn Header="Type" Binding="{Binding ExpenseType}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="110" />
                    <DataGridTextColumn Header="Paid By" Binding="{Binding PaidBy}" Width="120" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Expense Details" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Expense Type" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableExpense.ExpenseType, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Category" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditableExpense.Category}" />
                <TextBlock Text="Amount" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableExpense.Amount, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Date" FontWeight="SemiBold" />
                <DatePicker SelectedDate="{Binding EditableExpense.ExpenseDate}" />
                <TextBlock Text="Paid By" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding EditableExpense.PaidBy}" />
                <TextBlock Text="Note" FontWeight="SemiBold" />
                <TextBox Text="{Binding EditableExpense.Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" />
                <Button Content="Save Expense" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
