<UserControl x:Class="ClientProManager.Views.ProductServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Products &amp; Services" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" />
                <WrapPanel>
                    <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name, code, category" />
                    <ComboBox Width="170" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                    <Button Content="Search" Command="{Binding LoadCommand}" />
                    <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Disable" Command="{Binding DisableCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90" />
                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" />
                    <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRate, StringFormat=N2}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Item Details" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Name" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Code" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.Code, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Category" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.Category, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Description" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="66" />
                    <TextBlock Text="Unit" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.Unit, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Unit Price" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Tax Rate" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.TaxRate, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Material Type" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableItem.MaterialType, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Service" IsChecked="{Binding EditableItem.IsService}" Margin="0,8,0,4" />
                    <CheckBox Content="Product" IsChecked="{Binding EditableItem.IsProduct}" Margin="0,0,0,8" />
                    <Button Content="Save Product/Service" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
