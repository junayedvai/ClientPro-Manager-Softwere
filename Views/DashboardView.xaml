<UserControl x:Class="ClientProManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Dashboard"
                           FontSize="28"
                           FontWeight="Bold"
                           DockPanel.Dock="Left" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right" />
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Total Clients" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalClients}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Total Invoices" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalInvoices}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Paid Amount" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalPaidAmount, StringFormat={}{0:N2} BDT}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Due Amount" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalDueAmount, StringFormat={}{0:N2} BDT}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Monthly Income" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.MonthlyIncome, StringFormat={}{0:N2} BDT}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Monthly Expense" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.MonthlyExpense, StringFormat={}{0:N2} BDT}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Net Profit" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Summary.NetProfit, StringFormat={}{0:N2} BDT}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recent Invoices" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding RecentInvoices}" Height="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                                <DataGridTextColumn Header="Client" Binding="{Binding Client.ClientName}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pending Payments" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding PendingInvoices}" Height="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                                <DataGridTextColumn Header="Client" Binding="{Binding Client.ClientName}" Width="*" />
                                <DataGridTextColumn Header="Due" Binding="{Binding DueAmount, StringFormat=N2}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Overdue Clients" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding OverdueInvoices}" Height="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                                <DataGridTextColumn Header="Client" Binding="{Binding Client.ClientName}" Width="*" />
                                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=d}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
