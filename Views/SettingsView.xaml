<UserControl x:Class="ClientProManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Company Settings" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Company Name" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBox Text="{Binding Settings.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Owner Name" FontWeight="SemiBold" />
                <TextBox Text="{Binding Settings.OwnerName, UpdateSourceTrigger=PropertyChanged}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Phone" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.Phone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Email" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Address" FontWeight="SemiBold" />
                <TextBox Text="{Binding Settings.Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" />
                <TextBlock Text="Website" FontWeight="SemiBold" />
                <TextBox Text="{Binding Settings.Website, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Logo Path" FontWeight="SemiBold" />
                <TextBox Text="{Binding Settings.LogoPath, UpdateSourceTrigger=PropertyChanged}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Currency" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.Currency, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Tax Name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.TaxName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Default Tax Rate" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.DefaultTaxRate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Invoice Prefix" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.InvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Quotation Prefix" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.QuotationPrefix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Payment Prefix" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.PaymentPrefix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Terms and Conditions" FontWeight="SemiBold" />
                <TextBox Text="{Binding Settings.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reload" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Save Settings" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
