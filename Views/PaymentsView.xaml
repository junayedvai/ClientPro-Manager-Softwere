<UserControl x:Class="ClientProManager.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Payment Tracking" FontSize="28" FontWeight="Bold" />
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="160">
                        <TextBlock Text="From" />
                        <DatePicker SelectedDate="{Binding FromDate}" />
                    </StackPanel>
                    <StackPanel Width="160">
                        <TextBlock Text="To" />
                        <DatePicker SelectedDate="{Binding ToDate}" />
                    </StackPanel>
                    <StackPanel Width="160">
                        <TextBlock Text="Method" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" />
                    </StackPanel>
                    <Button Content="Filter" Command="{Binding LoadCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Payment History" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number" Binding="{Binding PaymentNumber}" Width="130" />
                            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat=d}" Width="100" />
                            <DataGridTextColumn Header="Client" Binding="{Binding Client.ClientName}" Width="*" />
                            <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice.InvoiceNumber}" Width="130" />
                            <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="110" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Due After" Binding="{Binding DueAmountAfterPayment, StringFormat=N2}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Export Receipt PDF"
                            Command="{Binding ExportReceiptCommand}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Add Payment" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Invoice" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DueInvoices}"
                              SelectedItem="{Binding SelectedInvoice}"
                              DisplayMemberPath="InvoiceNumber" />
                    <TextBlock Text="{Binding SelectedInvoice.Client.ClientName, StringFormat=Client: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding SelectedInvoice.DueAmount, StringFormat=Invoice due: {0:N2} BDT}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Payment Date" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding NewPayment.PaymentDate}" />
                    <TextBlock Text="Method" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding NewPayment.PaymentMethod}" />
                    <TextBlock Text="Paid Amount" FontWeight="SemiBold" />
                    <TextBox Text="{Binding NewPayment.PaidAmount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Transaction Note" FontWeight="SemiBold" />
                    <TextBox Text="{Binding NewPayment.TransactionNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" />
                    <Button Content="Add Payment" Command="{Binding AddPaymentCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
